table D_Date
	lineageTag: 1b4e06d9-a547-4213-992d-8d1ea85997bd

	column k_date
		dataType: int64
		formatString: 0
		lineageTag: 7218ee01-8c65-442d-9618-62b97427307f
		summarizeBy: none
		sourceColumn: k_date

		annotation SummarizationSetBy = Automatic

	column full_date
		dataType: dateTime
		formatString: Long Date
		lineageTag: 68427b4c-e0c5-4c9b-aef2-e4a5bea79b58
		summarizeBy: none
		sourceColumn: full_date

		variation Variation
			isDefault
			relationship: e7b293dd-149a-46ad-b47d-6dda8b101e20
			defaultHierarchy: LocalDateTable_fcc5b705-2422-4dad-9f5e-871648df7459.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column day
