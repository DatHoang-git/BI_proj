	column quarter
		dataType: int64
		formatString: 0
		lineageTag: 2064b1c8-5879-46ab-86cd-ca52eb42d9c9
		summarizeBy: sum
		sourceColumn: quarter

		annotation SummarizationSetBy = Automatic

	column year
		dataType: int64
		formatString: 0
		lineageTag: 549c6ea8-f8b6-49ae-9eb1-6a9ca9d9862c
		summarizeBy: sum
		sourceColumn: year

		annotation SummarizationSetBy = Automatic

	partition D_Date = m
		mode: import
		queryGroup: Dimensions
		source =
				let
				    StartDate = #date(2000, 1, 1),
				    EndDate = #date(2025, 4, 1),
				
				    NumberOfDays =
				        Duration.Days(EndDate - StartDate) + 1,
				
				    DateList =
				        List.Dates(
				            StartDate,
				            NumberOfDays,
				            #duration(1, 0, 0, 0)
				        ),
				
				    Source =
				        Table.FromList(
				            DateList,
				            Splitter.SplitByNothing(),
				            {"full_date"}
				        ),
				
				    ChangedType =
				        Table.TransformColumnTypes(
				            Source,
				            {{"full_date", type date}}
				        ),
				
				    AddDateKey =
				        Table.AddColumn(
				            ChangedType,
				            "date_key",
				            each Date.Year([full_date]) * 10000
				               + Date.Month([full_date]) * 100
				               + Date.Day([full_date]),
				            Int64.Type
				        ),
				
				    AddDay =
				        Table.AddColumn(
				            AddDateKey,
				            "day",
				            each Date.Day([full_date]),
				            Int64.Type
				        ),
				
				    AddDayOfWeek =
				        Table.AddColumn(
				            AddDay,
				            "day_of_week",
				            each Date.DayOfWeek([full_date], Day.Monday) + 1,
				            Int64.Type
				        ),
				
				    AddDayName =
				        Table.AddColumn(
				            AddDayOfWeek,
				            "day_name",
				            each Date.DayOfWeekName([full_date], "en-US"),
				            type text
				        ),
				
				    AddWeek =
				        Table.AddColumn(
				            AddDayName,
				            "week_of_year",
				            each Date.WeekOfYear([full_date], Day.Monday),
				            Int64.Type
				        ),
				
				    AddMonth =
				        Table.AddColumn(
				            AddWeek,
				            "month",
				            each Date.Month([full_date]),
				            Int64.Type
				        ),
				
				    AddMonthName =
				        Table.AddColumn(
				            AddMonth,
				            "month_name",
				            each Date.MonthName([full_date], "en-US"),
				            type text
				        ),
				
				    AddQuarter =
				        Table.AddColumn(
				            AddMonthName,
				            "quarter",
				            each Date.QuarterOfYear([full_date]),
				            Int64.Type
				        ),
				
				    AddYear =
				        Table.AddColumn(
				            AddQuarter,
				            "year",
				            each Date.Year([full_date]),
				            Int64.Type
				        ),
				
				    ReorderedColumns =
				        Table.ReorderColumns(
				            AddYear,
				            {
				                "date_key",
				                "full_date",
				                "day",
				                "day_of_week",
				                "day_name",
				                "week_of_year",
				                "month",
				                "month_name",
				                "quarter",
				                "year"
				            }
				        ),
				    #"Renamed Columns" = Table.RenameColumns(ReorderedColumns,{{"date_key", "k_date"}})
				in
				    #"Renamed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

