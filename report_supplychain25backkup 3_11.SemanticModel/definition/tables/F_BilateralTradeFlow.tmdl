	column k_importer
		dataType: int64
		formatString: 0
		lineageTag: bbc6dec4-b79f-4f36-814c-fde601b3212a
		summarizeBy: sum
		sourceColumn: k_importer

		annotation SummarizationSetBy = Automatic

	column corridor = 'F_BilateralTradeFlow'[exporter] & " -> " & 'F_BilateralTradeFlow'[importer]
		lineageTag: 9acda4e1-e194-4820-b5eb-e608c0b9eda4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column exporter =
			
			LOOKUPVALUE(
			    'D_TradingEntity'[trading_entity],
			    'D_TradingEntity'[k_trading_entity],
			    'F_BilateralTradeFlow'[k_exporter]
			)
		lineageTag: 4a9a55da-3fb8-4a7b-92dc-205623b1bcc7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column importer =
			
			LOOKUPVALUE(
			    'D_TradingEntity'[trading_entity],
			    'D_TradingEntity'[k_trading_entity],
			    'F_BilateralTradeFlow'[k_importer]
			)
		lineageTag: 7686df77-e71e-4f22-8b19-0eafc5ba1a4d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column tariff_tier =
			
			IF(
			    'F_BilateralTradeFlow'[effective_tariff_rate_pct] > 2.5,
			    "Chịu sốc thuế quan (>2.5%)",
			    "Thuế nền ổn định (≤2.5%)"
			)
		lineageTag: 01c7d458-ace6-4273-946c-5342253d5f6f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column tariff_cost_bn =
			
			'F_BilateralTradeFlow'[trade_value_bn_usd] * ('F_BilateralTradeFlow'[effective_tariff_rate_pct] / 100)
		lineageTag: bad6f1f2-d0e1-4ead-87e9-ee5f5ff978da
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

